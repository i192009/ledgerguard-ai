APP_ENV=development
DEMO_MODE=true
SEED_TRANSACTION_COUNT=10000
# These defaults are development-only; production startup rejects them.
DATABASE_URL=postgresql+asyncpg://ledgerguard:local-sandbox-only@localhost:15432/ledgerguard
REDIS_URL=redis://localhost:16379/0
TASK_MODE=celery
JWT_SECRET_KEY=development-only-change-this-secret-before-deployment-123456
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
METRICS_TOKEN=dev-monitoring-secret-change-me-before-deployment
MCP_CONTEXT_SECRET=dev-delegation-key-distinct-from-access-secret-change-me
MCP_TRANSACTIONS_URL=http://127.0.0.1:8101/mcp
MCP_RISK_URL=http://127.0.0.1:8102/mcp
MCP_RECONCILIATION_URL=http://127.0.0.1:8103/mcp
MCP_APPROVALS_URL=http://127.0.0.1:8104/mcp
MCP_TRANSACTIONS_TOKEN=dev-transactions-secret-change-me
MCP_RISK_TOKEN=dev-risk-secret-change-me
MCP_RECONCILIATION_TOKEN=dev-reconciliation-secret-change-me
MCP_APPROVALS_TOKEN=dev-approvals-secret-change-me
LLM_PROVIDER=offline
LLM_MODEL=
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint, otherwise omit LLM_BASE_URL.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ledgerguard
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TOOL_TIMEOUT_SECONDS=180
TOOL_BUDGET=40
APPROVAL_HOURS=24
TWO_PERSON_THRESHOLD=50000.00
SETTLEMENT_TOLERANCE_DAYS=3
HIGH_VALUE_THRESHOLD=10000.00
ARTIFACTS_DIR=artifacts
